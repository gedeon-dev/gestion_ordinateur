@page "/login"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Blazored.SessionStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage
@inject NavigationManager NavigationManager

<PageTitle>Connexion</PageTitle>

<h1>Connexion</h1>

<EditForm Model="credentials" FormName="LoginForm" OnValidSubmit="LoginAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="login" class="form-label">Login</label>
        <InputText id="login" class="form-control" @bind-Value="credentials.Login" />
        <ValidationMessage For="() => credentials.Login" />
    </div>

    <div class="mb-3">
        <label for="password" class="form-label">Mot de passe</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="credentials.Password" />
        <ValidationMessage For="() => credentials.Password" />
    </div>

    <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
        @(isSubmitting ? "Connexion..." : "Se connecter")
    </button>
</EditForm>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @messageCssClass mt-3" role="alert">@message</div>
}

@code {
    private const string TokenSessionKey = "authToken";
    private readonly LoginCredentials credentials = new();
    private bool isSubmitting;
    private string? message;
    private string messageCssClass = "alert-info";

    private async Task LoginAsync()
    {
        isSubmitting = true;
        message = null;

        try
        {
            var client = HttpClientFactory.CreateClient("AuthenticationApi");
            using var response = await client.PostAsJsonAsync(
                "api/authentication",
                new LoginRequest(credentials.Login, credentials.Password));

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                ShowMessage("Identifiant ou mot de passe invalide.", "alert-warning");
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                ShowMessage($"Le service d'authentification a répondu avec le statut {(int)response.StatusCode}.", "alert-danger");
                return;
            }

            var tokenResponse = await response.Content.ReadFromJsonAsync<TokenResponse>();
            if (string.IsNullOrWhiteSpace(tokenResponse?.Token))
            {
                ShowMessage("Le service d'authentification n'a pas renvoyé de token.", "alert-danger");
                return;
            }

            await SessionStorage.SetItemAsync(TokenSessionKey, tokenResponse.Token);
            credentials.Password = string.Empty;
            NavigationManager.NavigateTo("/");
        }
        catch (HttpRequestException)
        {
            ShowMessage("Impossible de joindre le service d'authentification.", "alert-danger");
        }
        catch (Microsoft.JSInterop.JSException)
        {
            ShowMessage("Le token a été obtenu, mais son enregistrement dans la session du navigateur a échoué.", "alert-danger");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ShowMessage(string text, string cssClass)
    {
        message = text;
        messageCssClass = cssClass;
    }

    private sealed class LoginCredentials
    {
        [Required(ErrorMessage = "Le login est obligatoire.")]
        public string Login { get; set; } = string.Empty;

        [Required(ErrorMessage = "Le mot de passe est obligatoire.")]
        public string Password { get; set; } = string.Empty;
    }

    private sealed record LoginRequest(string Login, string Password);

    private sealed class TokenResponse
    {
        public string Token { get; set; } = string.Empty;
    }
}
