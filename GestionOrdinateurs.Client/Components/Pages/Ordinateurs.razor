@page "/ordinateurs"
@using System.Globalization
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Blazored.SessionStorage
@using GestionOrdinateurs.Shared.Ordinateurs
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<PageTitle>Ordinateurs</PageTitle>

<h1>Ordinateurs</h1>

@if (isLoading)
{
    <p>Chargement des ordinateurs...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prix</th>
                <th>Devise</th>
                <th>Vendu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var ordinateur in ordinateurs)
            {
                <tr>
                    <td>@ordinateur.Nom</td>
                    <td>@ordinateur.Prix.ToString("F2", CultureInfo.GetCultureInfo("fr-FR"))</td>
                    <td>EUR</td>
                    <td>@(ordinateur.Vendu ? "Oui" : "Non")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const string TokenSessionKey = "authToken";
    private List<Ordinateur> ordinateurs = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var token = await SessionStorage.GetItemAsync<string>(TokenSessionKey);
        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage = "Connectez-vous pour consulter les ordinateurs.";
            isLoading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("ManagementApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var response = await client.GetAsync("api/Ordinateurs");

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Votre session a expiré. Reconnectez-vous.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "Vous n'êtes pas autorisé à consulter cette liste.";
            }
            else if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Impossible de récupérer les ordinateurs (HTTP {(int)response.StatusCode}).";
            }
            else
            {
                ordinateurs = await response.Content.ReadFromJsonAsync<List<Ordinateur>>() ?? [];
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre l'API de gestion des ordinateurs.";
        }

        isLoading = false;
        StateHasChanged();
    }
}
