@page "/reparations"
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using Blazored.SessionStorage
@inject IHttpClientFactory HttpClientFactory
@inject ISessionStorageService SessionStorage

<PageTitle>Historique des réparations</PageTitle>

<h1>Historique des réparations</h1>

@if (isLoading)
{
    <p>Chargement de l'historique...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-warning" role="alert">@errorMessage</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Ordinateur</th>
                <th>Technicien</th>
                <th>Type de réparation</th>
                <th>Date d'intervention</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reparation in reparations)
            {
                <tr>
                    <td>@reparation.NomOrdinateur</td>
                    <td>@reparation.Technicien</td>
                    <td>@reparation.TypeReparation</td>
                    <td>@reparation.DateIntervention.ToLocalTime().ToString("g")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const string TokenSessionKey = "authToken";
    private List<HistoriqueReparation> reparations = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var token = await SessionStorage.GetItemAsync<string>(TokenSessionKey);
        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage = "Connectez-vous pour consulter l'historique des réparations.";
            isLoading = false;
            StateHasChanged();
            return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("ManagementApi");
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            using var response = await client.GetAsync("api/Reparation/historique");

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                errorMessage = "Votre session a expiré. Reconnectez-vous.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "Vous n'êtes pas autorisé à consulter cet historique.";
            }
            else if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Impossible de récupérer l'historique (HTTP {(int)response.StatusCode}).";
            }
            else
            {
                reparations = await response.Content.ReadFromJsonAsync<List<HistoriqueReparation>>() ?? [];
            }
        }
        catch (HttpRequestException)
        {
            errorMessage = "Impossible de joindre l'API de gestion des réparations.";
        }

        isLoading = false;
        StateHasChanged();
    }

    private sealed record HistoriqueReparation(
        int OrdinateurId,
        string NomOrdinateur,
        string Technicien,
        string TypeReparation,
        DateTime DateIntervention);
}
