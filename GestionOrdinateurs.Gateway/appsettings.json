{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8180/realms/gestion-ordinateurs"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5153",
      "https://localhost:7135"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "ordinateurs": {
        "ClusterId": "gestionOrdinateurs",
        "Match": {
          "Path": "/api/Ordinateurs/{**catch-all}"
        }
      },
      "reparations": {
        "ClusterId": "gestionOrdinateurs",
        "Match": {
          "Path": "/api/Reparation/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestionOrdinateurs": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:5015/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
